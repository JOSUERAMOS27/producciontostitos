rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo los correos de esta lista pueden ver y cambiar los datos de Tostitos.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["TU_CORREO@gmail.com"];
    }
  }
}
